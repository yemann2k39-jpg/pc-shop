# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# AI assistant — any OpenAI-compatible endpoint works.
# Groq (free): AI_BASE_URL=https://api.groq.com/openai/v1 and a key from console.groq.com
# Model examples: llama-3.3-70b-versatile (Groq), gpt-4o-mini (OpenAI)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Public base URL of this app, used for Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: override the SQLite database location (default: data/pc-shop.db)
# DATABASE_PATH=data/pc-shop.db
